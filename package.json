{
  "name": "orders-of-magnitude",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mods": "vite --open /mod-editor.html",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.js",
    "itch": "tsc --noEmit && vite build --base ./ --outDir itch/game --emptyOutDir",
    "itch:push": "node scripts/itch-push.mjs",
    "itch:zip": "node scripts/itch-zip.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "release": "npm run deploy && node scripts/release-itch.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "javascript-obfuscator": "^4.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
