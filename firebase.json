{
  "hosting": [
    {
      "site": "orders-of-magnitude",
      "public": "public",
      "ignore": ["firebase.json", "**/.*"],
      "headers": [
        { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ]
    },
    {
      "site": "orders-of-magnitude-game",
      "public": "public",
      "redirects": [{ "source": "**", "destination": "https://orders-of-magnitude.web.app", "type": 301 }]
    }
  ]
}
